# DTW dev environment template.
# Copy to `.env.local` (gitignored) and fill in the values below.
# See process/context/infra/all-infra.md for the full env catalog.

# --- Database (Drizzle + Payload, hosted on Neon for dev) ---
# 1. Sign up at neon.tech (free tier)
# 2. Create project "dtw-dev"
# 3. Copy the "Pooled connection" string from the Neon dashboard
# 4. Paste it here as DATABASE_URL
# 5. Also set DATABASE_DIRECT_URL to the "Direct connection" (used by migrations)
#
# Production uses a separate Neon project / Supabase / etc — decided at deploy time.
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/dtw?sslmode=require"
DATABASE_DIRECT_URL="postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/dtw?sslmode=require"

# --- Better-Auth (Phase E2) ---
# Generate with `openssl rand -hex 32`
BETTER_AUTH_SECRET="replace_with_openssl_rand_hex_32"
BETTER_AUTH_URL="http://localhost:3000"

# OAuth — leave empty in dev; Better-Auth will only enable providers with creds.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Client-side button gates — MUST be kept in sync with the server creds above
# (e.g. set NEXT_PUBLIC_GOOGLE_ENABLED=true only once GOOGLE_CLIENT_ID/SECRET
# are set). Never hardcode these to "true" in code; a mismatch would render a
# button whose provider isn't actually registered server-side. Apple is not
# wired in this pass (email+password + Google/GitHub only) — see
# process/features/account/active/reader-auth-account-simple_PLAN_03-07-26.md.
NEXT_PUBLIC_GOOGLE_ENABLED=""
NEXT_PUBLIC_GITHUB_ENABLED=""

# --- Email (Resend) ---
# Sign up at resend.com; in dev you can leave blank and auth emails (verify,
# reset password, change email) log to the server console instead.
RESEND_API_KEY=""
RESEND_FROM_DOMAIN="dailytechwire.com"

# --- Payload CMS (Phase E3) ---
PAYLOAD_SECRET="replace_with_openssl_rand_hex_32"

# First editorial admin, created idempotently by `pnpm db:seed` so a fresh DB
# can log into /admin. Leave unset to use Payload's create-first-user flow.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# --- Engine intake (Phase 5) ---
# Shared secret with the content-engine PayloadAdapter. The engine sends it as
# `Authorization: Bearer <token>` to POST /api/engine/intake; this app compares
# it constant-time. MUST be identical to DTW_INTAKE_TOKEN in content-engine's .env.
# Generate with `openssl rand -hex 32`.
DTW_INTAKE_TOKEN=""

# --- Dashboard refresh cron (AI Leaderboard, Group G) ---
# Shared secret for /api/dashboards/refresh/[source]. Vercel's automatic cron
# `GET` invocation sends `Authorization: Bearer $CRON_SECRET` — set the
# Vercel project's CRON_SECRET env var to this SAME value (an ops step, not a
# code step: process/features/dashboards/active/ai-leaderboard-llmstats_PLAN_30-07-26.md's
# Ops Checklist). Manual/ops `curl` testing (POST) uses this value directly.
# Generate with `openssl rand -hex 32`.
DTW_DASHBOARD_REFRESH_TOKEN=""

# Free server-only key from llm-stats.com/developer. Powers the ai-weekly
# cron's LLM Stats adapter (apps/web/src/lib/dashboards/ai-llmstats.ts).
# Without it, the cron fails closed (no write) and the last-good/seeded
# aiModels data keeps rendering.
LLMSTATS_API_KEY=""

# --- Media storage: Cloudflare R2 (S3-compatible) ---
# Create an R2 bucket + API token (Object Read & Write). region is "auto".
# Without these, Payload falls back to local disk (dev only; not viable on Vercel).
R2_BUCKET="dtw-media"
R2_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# --- Central CMS integration (reader reads published content over HTTP) ---
# Pending cutover: the reader currently reads the local Payload instance
# (@/lib/payload-server). These are consumed by src/lib/central-api.ts +
# src/lib/cms-client.ts once the reader is switched over.
# CMS_URL: local central on :3508; in prod set to the deployed central URL.
CMS_URL="http://localhost:3508"
# CMS_READ_TOKEN: THIS tenant's read token (per-site secret). Mint in central
# admin or copy from the seed output — never commit a real value.
CMS_READ_TOKEN=""
# REVALIDATE_SECRET must EQUAL central's CENTRAL_SIGNING_SECRET (revalidate
# webhook + preview). Generate with `openssl rand -hex 32` — never commit a real
# value here; set it as an untracked local env var and in the Vercel dashboard.
REVALIDATE_SECRET=""
